{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["index.ts", "cli.ts", "libs", "modules", "tests", "bench", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
